{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: FastAPI (Simple)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "metacheck.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8082"
      ],
      "jinja": true,
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "python": "${workspaceFolder}/backend/.venv/bin/python"
    },
    {
      "name": "Python: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PORT": "8082",
        "DEBUG": "1"
      },
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "stopOnEntry": false,
      "showReturnValue": true,
      "redirectOutput": true,
      "purpose": ["debug-in-terminal"]
    },
    {
      "name": "Python: FastAPI (Alt Port)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PORT": "8083",
        "DEBUG": "1"
      },
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "stopOnEntry": false,
      "showReturnValue": true,
      "redirectOutput": true,
      "purpose": ["debug-in-terminal"]
    }
  ]
}
